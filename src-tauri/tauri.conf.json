{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parchment",
  "version": "0.1.0",
  "identifier": "com.grinmedia.parchment",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Parchment",
        "width": 1280,
        "height": 832,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "publisher": "GRIN Media",
    "copyright": "© 2026 GRIN Media",
    "shortDescription": "A local-first writing studio",
    "longDescription": "Parchment — a serious local-first writing studio for novels, scripts, poetry and worldbuilding.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/contact773/parchment/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCRkJBM0U0OUZGN0Q1MzUKUldRMTFmZWY1S1A3YTlmWEpxTHh0OUQzSysyejJ5dy9lNW1oWUwvSnM3WkZaUjhWMHNPY09TZGwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
